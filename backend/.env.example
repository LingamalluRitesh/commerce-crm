# CommerceCRM Enterprise Environment Configuration Template
# Copy this file to .env and customize values for your deployment.

ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=sqlite+aiosqlite:///./commerce_crm.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/commerce_crm

# Redis Cache & Event Bus
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-for-jwt-tokens-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENFORCE_MFA=false

# Multi-Tenancy
DEFAULT_TENANT_ID=default-tenant-enterprise-001

# Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=commercecrm-media
